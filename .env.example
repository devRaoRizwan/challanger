# Set these in Vercel → Project → Settings → Environment Variables.
# Use 6+ characters; the PIN lets you tick problems; without it the page is view-only.
RAO_PIN=

# Added automatically when you connect Upstash Redis from the Vercel Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# WhatsApp reminders (CallMeBot). See README → "WhatsApp reminders".
CALLMEBOT_PHONE=+92XXXXXXXXXX
CALLMEBOT_APIKEY=
CRON_SECRET=
REMIND_TZ=Asia/Karachi
SITE_URL=https://your-project.vercel.app
